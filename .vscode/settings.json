    "PATH": "/opt/esp-tools/xtensa-esp-elf/esp-13.2.0_20250523/xtensa-esp-elf/bin:/opt/esp-tools/esp-rom-ulabels/bin:/opt/esp-tools/esptool_py/bi"
  },
  "C_Cpp.default.cppStandard": "c++17",
